        "jsCode": "const text = $('Extract Message').first().json.text.trim().toLowerCase();\nconst session = $('Find Session').first().json;\nconst chatId = session.chat_id;\n\nif (text === 'approve') {\n  return [{ json: { review1_action: 'APPROVE', chat_id: chatId, content_json: session.content_json } }];\n} else if (text === 'skip') {\n  return [{ json: { review1_action: 'SKIP', chat_id: chatId } }];\n} else if (text.startsWith('edit:')) {\n  const feedback = text.replace(/^edit:\\s*/i, '').trim();\n  return [{ json: { review1_action: 'EDIT', chat_id: chatId, feedback, content_json: session.content_json } }];\n} else {\n  return [{ json: { review1_action: 'UNKNOWN', chat_id: chatId } }];\n}"
