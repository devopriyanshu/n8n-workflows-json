    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst rawText = response.content[0].text;\n\nlet contentData;\ntry {\n  contentData = JSON.parse(rawText);\n} catch(e) {\n  const match = rawText.match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    try { contentData = JSON.parse(match[0]); } catch(e2) { contentData = { error: 'parse_failed', raw: rawText }; }\n  } else {\n    contentData = { error: 'no_json_found', raw: rawText };\n  }\n}\n\nconst chatId = $('Extract Message').first().json.chat_id;\n\nconst preview = `📋 *CGS DRAFT — ${(contentData.post_type || 'POST').replace(/_/g,' ').toUpperCase()}*\\n\\n━━━━━━━━━━━━━━━━━\\n🏷 *Category:* ${contentData.category_label || ''}\\n📊 *Stat:* ${contentData.stat_number || ''}\\n   _${contentData.stat_label || ''}_\\n   _${contentData.stat_context || ''}_\\n\\n💡 *Insight:*\\n${contentData.insight_text || ''}\\n\\n${contentData.hashtags || ''}\\n━━━━━━━━━━━━━━━━━\\n\\n📝 *Caption preview:*\\n${(contentData.caption || '').substring(0, 250)}...\\n\\n━━━━━━━━━━━━━━━━━\\nReply:\\n✅ *approve* — render image\\n✏️ *edit: [feedback]* — Claude rewrites\\n❌ *skip* — discard`;\n\nreturn [{ json: { preview_msg: preview, content_json: JSON.stringify(contentData), chat_id: chatId } }];"
