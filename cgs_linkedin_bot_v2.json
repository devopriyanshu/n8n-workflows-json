    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst articles = [];\nconst seen = new Set();\n\nfor (const item of allItems) {\n  const d = item.json;\n  if (d.articles) {\n    for (const a of (d.articles || [])) {\n      if (!a.title) continue;\n      const k = a.title.toLowerCase().substring(0, 50);\n      if (seen.has(k)) continue;\n      seen.add(k);\n      articles.push({ source: a.source?.name || 'NewsAPI', title: a.title, description: (a.description || '').substring(0, 200) });\n    }\n  } else if (d.data?.children) {\n    for (const post of (d.data.children || [])) {\n      const p = post.data;\n      if (!p.title || p.score < 3) continue;\n      const k = p.title.toLowerCase().substring(0, 50);\n      if (!seen.has(k)) {\n        seen.add(k);\n        articles.push({ source: 'Reddit', title: p.title, description: (p.selftext || '').substring(0, 200) });\n      }\n    }\n  }\n}\n\nconst top8 = articles.slice(0, 8);\nconst formatted = top8.map((a, i) => `${i+1}. [${a.source}] ${a.title}\\n   ${a.description}...`).join('\\n\\n');\n\nconst session = $('Find Session').first().json;\nreturn [{ json: { articles_text: formatted, chat_id: session.chat_id, topic: $('Extract Topic').first().json.topic, mode: 'CUSTOM' } }];"
