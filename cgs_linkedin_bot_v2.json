      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst articles = [];\nconst seen = new Set();\n\nfor (const item of allItems) {\n  const d = item.json;\n  if (d.articles) {\n    for (const a of (d.articles || [])) {\n      if (!a.title) continue;\n      const k = a.title.toLowerCase().substring(0, 50);\n      if (seen.has(k)) continue;\n      seen.add(k);\n      articles.push({ source: a.source?.name || 'NewsAPI', title: a.title, description: (a.description || '').substring(0, 200) });\n    }\n  } else if (d.title && d.link) {\n    const k = d.title.toLowerCase().substring(0, 50);\n    if (!seen.has(k)) {\n      seen.add(k);\n      articles.push({ source: 'RSS', title: d.title, description: (d.contentSnippet || '').substring(0, 200) });\n    }\n  }\n}\n\nconst top8 = articles.slice(0, 8);\nconst formatted = top8.map((a, i) => `${i+1}. [${a.source}] ${a.title}\\n   ${a.description}...`).join('\\n\\n');\n\nconst chatId = $('Extract Message').first().json.chat_id;\nreturn [{ json: { articles_text: formatted, chat_id: chatId, topic: '', mode: 'NEWS' } }];"
